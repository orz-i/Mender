{
  "name": "@mender/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit && vite build --mode production",
    "build:dev": "tsc --project tsconfig.json --noEmit && vite build --minify false --mode development",
    "dev": "vite",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mender/app": "workspace:*",
    "@mender/sdk": "workspace:*",
    "@mender/ui": "workspace:*",
    "@wailsio/runtime": "3.0.0-beta.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
