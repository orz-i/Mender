{
  "name": "mender",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm provider-plugin:proto:check && pnpm provider-plugin:sdk:lint && pnpm provider-plugin:sdk:test && pnpm provider-plugin:sdk:test:race && pnpm sdk:check && pnpm desktop:bindings:check && pnpm desktop:architecture:check && pnpm go:lint && pnpm go:test && pnpm go:test:race && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "desktop:architecture:check": "node scripts/check-desktop-architecture.mjs",
    "desktop:bindings:check": "node scripts/check-desktop-bindings.mjs",
    "dev:web": "pnpm --filter @mender/web dev",
    "go:bench:catalog": "go test ./backend/internal/catalog/infrastructure/sqlite -run '^$' -bench 'BenchmarkCatalog(Search|ScopedSearch)10K' -benchmem",
    "go:lint": "golangci-lint run ./backend/...",
    "go:test": "go test ./backend/...",
    "go:test:race": "go test -race ./backend/...",
    "lint": "eslint apps packages",
    "provider-plugin:proto:check": "GOWORK=off go run github.com/bufbuild/buf/cmd/buf@v1.73.0 lint && pnpm provider-plugin:proto:generate && git diff --exit-code -- sdk/providerplugin/go/protocol/v1",
    "provider-plugin:proto:generate": "GOWORK=off go run github.com/bufbuild/buf/cmd/buf@v1.73.0 generate",
    "provider-plugin:sdk:lint": "cd sdk/providerplugin/go && GOWORK=off golangci-lint run ./...",
    "provider-plugin:sdk:test": "cd sdk/providerplugin/go && GOWORK=off go test ./...",
    "provider-plugin:sdk:test:race": "cd sdk/providerplugin/go && GOWORK=off go test -race ./...",
    "run:cli": "go run ./backend/cmd/mender",
    "run:server": "go run ./backend/cmd/menderd",
    "release:checksums": "node scripts/checksums.mjs",
    "release:checksums:verify": "node scripts/verify-checksums.mjs",
    "release:go": "node scripts/build-go-release.mjs",
    "release:sbom": "node scripts/sbom.mjs",
    "security:check": "pnpm security:go && pnpm security:js",
    "security:go": "node scripts/security-go.mjs",
    "security:js": "pnpm audit --prod --audit-level high",
    "sdk:check": "pnpm --filter @mender/sdk generate && git diff --exit-code -- packages/sdk/src/generated/schema.ts",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
