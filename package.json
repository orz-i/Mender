{
  "name": "mender",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "pnpm go:lint && pnpm go:test && pnpm go:test:race && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @mender/web dev",
    "go:lint": "golangci-lint run ./backend/...",
    "go:test": "go test ./backend/...",
    "go:test:race": "go test -race ./backend/...",
    "lint": "eslint apps packages",
    "run:cli": "go run ./backend/cmd/mender",
    "run:server": "go run ./backend/cmd/menderd",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
