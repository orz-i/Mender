{
  "name": "mender",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "backend:architecture:check": "go test scripts/check-backend-architecture.go scripts/check-backend-architecture_test.go && go run scripts/check-backend-architecture.go",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm scripts:test && pnpm backend:architecture:check && pnpm provider-plugin:proto:check && pnpm provider-plugin:sdk:lint && pnpm provider-plugin:sdk:test && pnpm provider-plugin:sdk:test:race && pnpm provider-plugin:example:lint && pnpm provider-plugin:example:test && pnpm provider-plugin:example:test:race && pnpm provider-plugin:example:build && pnpm sandbox-plugin:sdk:check && pnpm sandbox-plugin:example:check && pnpm tunnel-plugin:sdk:check && pnpm tunnel-plugin:example:check && pnpm go:modules:check && pnpm sdk:check && pnpm desktop:bindings:check && pnpm desktop:architecture:check && pnpm go:lint && pnpm go:test && pnpm go:test:race && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "desktop:architecture:check": "node scripts/check-desktop-architecture.mjs",
    "desktop:bindings:check": "node scripts/check-desktop-bindings.mjs",
    "dev:web": "pnpm --filter @mender/web dev",
    "go:bench:catalog": "go test ./backend/internal/catalog/infrastructure/sqlite -run '^$' -bench 'BenchmarkCatalog(Search|ScopedSearch)10K' -benchmem",
    "go:lint": "golangci-lint run ./backend/...",
    "go:modules:check": "node scripts/check-go-modules.mjs",
    "go:test": "go test ./backend/...",
    "go:test:race": "go test -race ./backend/...",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint": "eslint apps packages",
    "provider-plugin:example:build": "node scripts/check-plugins.mjs provider-plugin:example:build",
    "provider-plugin:example:lint": "node scripts/check-plugins.mjs provider-plugin:example:lint",
    "provider-plugin:example:test": "node scripts/check-plugins.mjs provider-plugin:example:test",
    "provider-plugin:example:test:race": "node scripts/check-plugins.mjs provider-plugin:example:test:race",
    "provider-plugin:proto:check": "node scripts/check-plugins.mjs provider-plugin:proto:check",
    "provider-plugin:proto:generate": "node scripts/check-plugins.mjs provider-plugin:proto:generate",
    "provider-plugin:sdk:lint": "node scripts/check-plugins.mjs provider-plugin:sdk:lint",
    "provider-plugin:sdk:test": "node scripts/check-plugins.mjs provider-plugin:sdk:test",
    "provider-plugin:sdk:test:race": "node scripts/check-plugins.mjs provider-plugin:sdk:test:race",
    "run:cli": "go run ./backend/cmd/mender",
    "run:server": "go run ./backend/cmd/menderd",
    "release:checksums": "node scripts/checksums.mjs",
    "release:checksums:verify": "node scripts/verify-checksums.mjs",
    "release:go": "node scripts/build-go-release.mjs",
    "release:sbom": "node scripts/sbom.mjs",
    "security:check": "pnpm security:go && pnpm security:js",
    "security:go": "node scripts/security-go.mjs",
    "security:js": "pnpm audit --prod --audit-level high",
    "scripts:test": "node --test scripts/check-plugins.node-test.mjs",
    "sdk:check": "pnpm --filter @mender/sdk generate && git diff --exit-code -- packages/sdk/src/generated/schema.ts",
    "test": "pnpm i18n:check && vitest run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "sandbox-plugin:sdk:check": "node scripts/check-plugins.mjs sandbox-plugin:sdk:check",
    "sandbox-plugin:example:check": "node scripts/check-plugins.mjs sandbox-plugin:example:check",
    "tunnel-plugin:sdk:check": "node scripts/check-plugins.mjs tunnel-plugin:sdk:check",
    "tunnel-plugin:example:check": "node scripts/check-plugins.mjs tunnel-plugin:example:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
